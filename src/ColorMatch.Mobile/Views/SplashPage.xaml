<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ColorMatch.Mobile.Views.SplashPage">
    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="18" x:Name="Stack" Opacity="0">
        <Image Source="logo_tile" WidthRequest="128" HeightRequest="128" HorizontalOptions="Center" SemanticProperties.Description="ColorMatch logosu" />
        <Label Text="ColorMatch" Style="{StaticResource LargeTitle}" HorizontalOptions="Center" />
        <Label Text="Rengi bul. Fotoğrafla. Paylaş." Style="{StaticResource Muted}" HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
