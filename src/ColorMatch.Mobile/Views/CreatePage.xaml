<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ColorMatch.Mobile.Controls"
             xmlns:vm="clr-namespace:ColorMatch.Mobile.ViewModels"
             x:Class="ColorMatch.Mobile.Views.CreatePage">
    <ContentPage.Resources>
        <!-- editor tab: icon + label; the selected tool is filled with the soft accent -->
        <Style x:Key="ToolTab" TargetType="Border">
            <Setter Property="controls:Interact.TapFeedback" Value="True" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Padding" Value="0,11" />
        </Style>
        <Style x:Key="ToolLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="SansSemibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMutedDark}}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- toolbar: title on the left, export actions on the right -->
        <Grid Padding="20,8,12,4" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2">
            <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                <Label Text="Kolaj" Style="{StaticResource LargeTitle}" FontSize="24" />
                <Label Text="{Binding PhotoCountText}" Style="{StaticResource Caption}" IsVisible="{Binding HasPhotos}" />
            </VerticalStackLayout>
            <controls:IconButton Grid.Column="1" Kind="download" Tone="plain" Size="44" Label="Galeriye kaydet" Command="{Binding SaveCommand}" IsEnabled="{Binding CanExport}" />
            <controls:IconButton Grid.Column="2" Kind="share" Tone="plain" Size="44" Label="Paylaş" Command="{Binding ShareCommand}" IsEnabled="{Binding CanExport}" />
            <controls:AppButton Grid.Column="3" Text="Yayınla" Kind="primary" Compact="True" Margin="6,0,0,0" VerticalOptions="Center"
                                Command="{Binding PublishCommand}" IsEnabled="{Binding HasPhotos}" IsLoading="{Binding IsBusy}" />
        </Grid>

        <!-- canvas: the collage is the stage -->
        <Border Grid.Row="1" Margin="16,6,16,8" StrokeThickness="0" StrokeShape="RoundRectangle 28" Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}">
            <Grid>
                <Image x:Name="Preview" Source="{Binding PreviewSource}" Aspect="AspectFit" IsVisible="{Binding HasPhotos}" Margin="16" SemanticProperties.Description="Kolaj önizlemesi" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" VerticalOptions="Center" />

                <!-- empty state -->
                <VerticalStackLayout IsVisible="{Binding NoPhotos}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="14" Padding="32">
                    <Border WidthRequest="72" HeightRequest="72" StrokeShape="RoundRectangle 24" StrokeThickness="0" HorizontalOptions="Center"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}">
                        <controls:IconView Kind="layers" Size="30" Accent="True" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="Bir kolajla başla" Style="{StaticResource Title}" HorizontalTextAlignment="Center" />
                    <Label Text="Fotoğraflarını seç; şablonu, arka planı ve renk paletini sonra birlikte ayarlarız." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                    <controls:AppButton Text="Fotoğraf seç" Kind="primary" HorizontalOptions="Center" Command="{Binding PickPhotosCommand}" IsLoading="{Binding IsBusy}" />
                    <Label Text="En fazla 6 fotoğraf" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- tool panel: Layouts / Colors / Photos -->
        <Border Grid.Row="2" IsVisible="{Binding HasPhotos}" StrokeThickness="0" StrokeShape="RoundRectangle 28,28,0,0" Padding="16,12,16,10"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <VerticalStackLayout Spacing="12">
                <Label Text="{Binding InfoMessage}" IsVisible="{Binding InfoMessage, Converter={StaticResource NotEmpty}}" Style="{StaticResource SuccessText}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding InfoIsError}" Value="True">
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <Border Style="{StaticResource ToolTab}" SemanticProperties.Description="Şablonlar">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsLayoutsTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                            <controls:IconView Kind="layers" Size="18" Muted="True" VerticalOptions="Center">
                                <controls:IconView.Triggers>
                                    <DataTrigger TargetType="controls:IconView" Binding="{Binding IsLayoutsTab}" Value="True"><Setter Property="Accent" Value="True" /></DataTrigger>
                                </controls:IconView.Triggers>
                            </controls:IconView>
                            <Label Text="Şablonlar" Style="{StaticResource ToolLabel}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsLayoutsTab}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="layouts" /></Border.GestureRecognizers>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ToolTab}" SemanticProperties.Description="Renkler">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsColorsTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                            <controls:IconView Kind="palette" Size="18" Muted="True" VerticalOptions="Center">
                                <controls:IconView.Triggers>
                                    <DataTrigger TargetType="controls:IconView" Binding="{Binding IsColorsTab}" Value="True"><Setter Property="Accent" Value="True" /></DataTrigger>
                                </controls:IconView.Triggers>
                            </controls:IconView>
                            <Label Text="Renkler" Style="{StaticResource ToolLabel}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsColorsTab}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="colors" /></Border.GestureRecognizers>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource ToolTab}" SemanticProperties.Description="Fotoğraflar">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsPhotosTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                            <controls:IconView Kind="image" Size="18" Muted="True" VerticalOptions="Center">
                                <controls:IconView.Triggers>
                                    <DataTrigger TargetType="controls:IconView" Binding="{Binding IsPhotosTab}" Value="True"><Setter Property="Accent" Value="True" /></DataTrigger>
                                </controls:IconView.Triggers>
                            </controls:IconView>
                            <Label Text="Fotoğraflar" Style="{StaticResource ToolLabel}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsPhotosTab}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="photos" /></Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- tab content (fixed minimum height so the canvas does not jump when switching tabs) -->
                <Grid MinimumHeightRequest="132">

                    <!-- LAYOUTS: template drawings + format -->
                    <VerticalStackLayout IsVisible="{Binding IsLayoutsTab}" Spacing="12">
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Templates}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="5" WidthRequest="66" SemanticProperties.Description="{Binding Title}">
                                            <controls:TemplateGlyph Template="{Binding Value}" IsSelected="{Binding IsSelected}" HorizontalOptions="Center" />
                                            <Label Text="{Binding Title}" FontSize="11" HorizontalTextAlignment="Center" FontFamily="SansSemibold" />
                                            <VerticalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectTemplateCommand, Source={RelativeSource AncestorType={x:Type vm:CreateViewModel}}}" CommandParameter="{Binding .}" />
                                            </VerticalStackLayout.GestureRecognizers>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                        <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Formats}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Padding="14,0" MinimumHeightRequest="40" BackgroundColor="Transparent"
                                            Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}" />
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding Title}" FontFamily="SansSemibold" FontSize="13" VerticalOptions="Center" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectFormatCommand, Source={RelativeSource AncestorType={x:Type vm:CreateViewModel}}}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- COLORS: background swatches + palette -->
                    <VerticalStackLayout IsVisible="{Binding IsColorsTab}" Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Arka plan" Style="{StaticResource Caption}" VerticalOptions="Center" />
                            <controls:AppButton Grid.Column="1" Text="Günün rengi" Kind="ghost" Command="{Binding UseTodayColorCommand}" />
                        </Grid>
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Backgrounds}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <controls:ColorSwatch Hex="{Binding Value.Hex}" Size="40" IsSelected="{Binding IsSelected}"
                                                              Command="{Binding SelectBackgroundCommand, Source={RelativeSource AncestorType={x:Type vm:CreateViewModel}}}" CommandParameter="{Binding .}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="1">
                                <Label Text="Renk paleti" FontFamily="SansSemibold" FontSize="14" />
                                <Label Text="Baskın renkler HEX etiketiyle eklenir" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding ShowPalette}" VerticalOptions="Center" SemanticProperties.Description="Renk paletini göster" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- PHOTOS: thumbnails, add, remove, replace all -->
                    <VerticalStackLayout IsVisible="{Binding IsPhotosTab}" Spacing="10">
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="10">
                                <HorizontalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Thumbs}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid WidthRequest="68" HeightRequest="88">
                                                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="0"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}">
                                                    <Image Source="{Binding Source}" Aspect="AspectFill" />
                                                </Border>
                                                <Border WidthRequest="26" HeightRequest="26" StrokeShape="RoundRectangle 13" StrokeThickness="0" HorizontalOptions="End" VerticalOptions="Start" Margin="0,4,4,0"
                                                        BackgroundColor="#B3000000" SemanticProperties.Description="Fotoğrafı kaldır">
                                                    <controls:IconView Kind="x" Size="14" StrokeWidth="2.4" Tint="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding RemovePhotoCommand, Source={RelativeSource AncestorType={x:Type vm:CreateViewModel}}}" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                                <Border WidthRequest="68" HeightRequest="88" StrokeShape="RoundRectangle 12" StrokeThickness="1.5" StrokeDashArray="4,3" BackgroundColor="Transparent"
                                        IsVisible="{Binding CanAddPhotos}" SemanticProperties.Description="Fotoğraf ekle"
                                        Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}">
                                    <controls:IconView Kind="plus" Size="22" Muted="True" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding AddPhotosCommand}" /></Border.GestureRecognizers>
                                </Border>
                            </HorizontalStackLayout>
                        </ScrollView>
                        <controls:AppButton Text="Tüm fotoğrafları değiştir" Kind="ghost" Command="{Binding PickPhotosCommand}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <controls:BottomBar Grid.Row="3" ActiveTab="create" />

        <controls:CaptionSheet Grid.RowSpan="4" IsOpen="{Binding IsCaptionOpen}" Text="{Binding CaptionText, Mode=TwoWay}" Title="Kolajına not ekle"
                               Subtitle="İstersen kolajınla ilgili birkaç söz yaz." ConfirmText="Yayınla"
                               ConfirmCommand="{Binding ConfirmPublishCommand}" CancelCommand="{Binding CancelPublishCommand}" />
    </Grid>
</ContentPage>
