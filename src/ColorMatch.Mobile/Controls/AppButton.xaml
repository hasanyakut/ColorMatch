<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ColorMatch.Mobile.Controls.AppButton">
    <!-- A tactile key: a coloured face sitting on a darker ledge. Pressing pushes the face down onto the ledge; releasing lets it spring back.
         The transparent native Button on top supplies real pressed / released / cancelled / accessibility behaviour. -->
    <Grid x:Name="Root">
        <Border x:Name="Ledge" StrokeThickness="0" />
        <Border x:Name="Face" StrokeThickness="0" Padding="22,0">
            <Grid>
                <Label x:Name="Caption" HorizontalOptions="Center" VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" InputTransparent="True"
                                   HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="22" HeightRequest="22" />
            </Grid>
        </Border>
        <Button x:Name="Inner" Clicked="OnInnerClicked" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Text="" />
    </Grid>
</ContentView>
