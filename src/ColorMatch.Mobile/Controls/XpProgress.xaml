<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ColorMatch.Mobile.Controls.XpProgress"
             x:Name="root">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
        <!-- level badge: a lime "sticker", slightly tilted -->
        <Border WidthRequest="54" HeightRequest="54" StrokeShape="RoundRectangle 18" StrokeThickness="0" Rotation="-4"
                BackgroundColor="{StaticResource Lime}">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                <Label Text="{Binding Level, Source={x:Reference root}}" FontFamily="DisplayHeavy" FontSize="26" HorizontalTextAlignment="Center" LineHeight="1"
                       TextColor="{StaticResource Night}" />
            </VerticalStackLayout>
        </Border>
        <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding Caption, Source={x:Reference root}}" Style="{StaticResource Headline}" />
                <Label Grid.Column="1" Text="{Binding XpText, Source={x:Reference root}}" Style="{StaticResource Caption}" VerticalOptions="Center" />
            </Grid>
            <!-- thin track + fill; the fill width animates when Progress changes -->
            <Border x:Name="Track" HeightRequest="10" StrokeThickness="0" StrokeShape="RoundRectangle 5" Padding="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                    SizeChanged="OnTrackSizeChanged">
                <Border x:Name="Fill" HeightRequest="10" WidthRequest="0" HorizontalOptions="Start" StrokeThickness="0" StrokeShape="RoundRectangle 5"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentView>
