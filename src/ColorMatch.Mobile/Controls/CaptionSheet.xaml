<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ColorMatch.Mobile.Controls"
             x:Class="ColorMatch.Mobile.Controls.CaptionSheet"
             x:Name="root"
             IsVisible="False">
    <!-- In-app bottom sheet for the note that goes with a post. Replaces the native text-prompt dialog. -->
    <Grid>
        <BoxView x:Name="Scrim" Color="#99000000" Opacity="0">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnScrimTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="Sheet" VerticalOptions="End" StrokeThickness="0" StrokeShape="RoundRectangle 28,28,0,0" Padding="20,10,20,18"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <VerticalStackLayout Spacing="14">
                <BoxView WidthRequest="36" HeightRequest="4" CornerRadius="2" HorizontalOptions="Center"
                         Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />

                <VerticalStackLayout Spacing="3">
                    <Label Text="{Binding Title, Source={x:Reference root}}" Style="{StaticResource Title}" />
                    <Label Text="{Binding Subtitle, Source={x:Reference root}}" Style="{StaticResource Muted}"
                           IsVisible="{Binding Subtitle, Source={x:Reference root}, Converter={StaticResource NotEmpty}}" />
                </VerticalStackLayout>

                <Border Style="{StaticResource InputBox}" Padding="14,6">
                    <Editor x:Name="Input" Text="{Binding Text, Source={x:Reference root}, Mode=TwoWay}" Placeholder="Bir not yaz… (isteğe bağlı)"
                            MaxLength="500" AutoSize="TextChanges" MinimumHeightRequest="96" MaximumHeightRequest="160"
                            SemanticProperties.Description="Gönderi notu" TextChanged="OnTextChanged" />
                </Border>
                <Label x:Name="Counter" Text="0 / 500" Style="{StaticResource Caption}" HorizontalOptions="End" Margin="0,-8,4,0" />

                <Grid ColumnDefinitions="2*,3*" ColumnSpacing="10">
                    <controls:AppButton Text="Vazgeç" Kind="secondary" Command="{Binding CancelCommand, Source={x:Reference root}}" />
                    <controls:AppButton Grid.Column="1" Text="{Binding ConfirmText, Source={x:Reference root}}" Kind="primary" Command="{Binding ConfirmCommand, Source={x:Reference root}}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
