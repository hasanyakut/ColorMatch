<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ColorMatch.Mobile.Controls"
             x:Class="ColorMatch.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <controls:InvertedBoolConverter x:Key="Not" />
            <controls:HexToColorConverter x:Key="HexToColor" />
            <controls:HexToInkConverter x:Key="HexToInk" />
            <controls:NotEmptyConverter x:Key="NotEmpty" />
            <controls:HexToInkBrushConverter x:Key="HexToInkBrush" />
            <controls:HexToBrushConverter x:Key="HexToBrush" />
            <controls:TimeAgoConverter x:Key="TimeAgo" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
