<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ================= Pages ================= -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
        <Setter Property="Shell.TabBarIsVisible" Value="False" />
    </Style>

    <!-- ================= Type scale =================
         Display 38 · LargeTitle 28 · ScreenTitle ("Title") 22 · SectionHeading ("Headline") 17 · Body 15 · Caption 12 · Label 11 · Button 15
         Hierarchy comes from size, weight, tracking and line height, not from colour. -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="LineHeight" Value="1.38" />
    </Style>
    <Style x:Key="Display" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontHeavy}" />
        <Setter Property="FontSize" Value="{StaticResource FontDisplay}" />
        <Setter Property="LineHeight" Value="0.98" />
        <Setter Property="CharacterSpacing" Value="-0.3" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level1" />
    </Style>
    <Style x:Key="LargeTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontHeavy}" />
        <Setter Property="FontSize" Value="{StaticResource FontLargeTitle}" />
        <Setter Property="LineHeight" Value="1.04" />
        <Setter Property="CharacterSpacing" Value="-0.2" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level1" />
    </Style>
    <Style x:Key="Title" TargetType="Label">
        <Setter Property="FontFamily" Value="SansBold" />
        <Setter Property="FontSize" Value="{StaticResource FontScreenTitle}" />
        <Setter Property="LineHeight" Value="1.15" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
    </Style>
    <Style x:Key="Headline" TargetType="Label">
        <Setter Property="FontFamily" Value="SansBold" />
        <Setter Property="FontSize" Value="{StaticResource FontSectionHeading}" />
        <Setter Property="LineHeight" Value="1.2" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level3" />
    </Style>
    <Style x:Key="Muted" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMutedDark}}" />
    </Style>
    <Style x:Key="Caption" TargetType="Label" BasedOn="{StaticResource Muted}">
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>
    <!-- small section label in sentence case (no tracked capitals) -->
    <Style x:Key="Overline" TargetType="Label" BasedOn="{StaticResource Muted}">
        <Setter Property="FontFamily" Value="{StaticResource FontStrong}" />
        <Setter Property="FontSize" Value="{StaticResource FontLabel}" />
        <Setter Property="CharacterSpacing" Value="0.6" />
    </Style>
    <!-- big figures (scores, XP): tight tracking -->
    <Style x:Key="Figure" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontHeavy}" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="LineHeight" Value="1" />
        <Setter Property="CharacterSpacing" Value="-0.8" />
    </Style>
    <Style x:Key="ErrorText" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="SuccessText" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
    </Style>

    <!-- ================= Surfaces =================
         Card    : white surface + hairline border (use sparingly: grouped content)
         CardAlt : recessed tile (no border)
         Chip    : compact pill -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape" Value="RoundRectangle 26" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="CardAlt" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style x:Key="SoftChip" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}" />
    </Style>
    <Style x:Key="Hairline" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
    </Style>

    <!-- ================= Buttons =================
         Primary   : the one main action of a screen (ink on paper; colour is left to the content)
         Secondary : surface with hairline border
         Ghost     : text only
         *Compact  : 40 dp variants for dense rows
         Pressed = slight dim + 2 % shrink, Disabled = 45 % opacity. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnInkLight}, Dark={StaticResource OnInkDark}}" />
        <Setter Property="FontFamily" Value="{StaticResource FontStrong}" />
        <Setter Property="FontSize" Value="{StaticResource FontButton}" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonRadius}" />
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"><VisualState.Setters><Setter Property="Opacity" Value="1" /><Setter Property="Scale" Value="1" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Property="Opacity" Value="0.86" /><Setter Property="Scale" Value="0.98" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.45" /></VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}" />
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}" />
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style x:Key="InkButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnInkLight}, Dark={StaticResource OnInkDark}}" />
    </Style>
    <Style x:Key="PrimaryCompact" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style x:Key="SecondaryCompact" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- ================= Inputs ================= -->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMutedDark}}" />
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="50" />
    </Style>
    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMutedDark}}" />
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>
    <Style x:Key="InputBox" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <!-- ================= Misc controls ================= -->
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
    </Style>
    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
    </Style>
    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="MaximumTrackColor" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}" />
    </Style>
    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
    </Style>
    <Style TargetType="CollectionView">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}" />
        <Setter Property="Shell.TabBarIsVisible" Value="False" />
    </Style>
</ResourceDictionary>
